                    <ServiceImplementation
                     description=""
                     handlerName="Script"
                     name="QueryMultiPropertiesForCharts">
                        <ConfigurationTables>
                            <ConfigurationTable
                             dataShapeName=""
                             description=""
                             isMultiRow="false"
                             name="Script"
                             ordinal="0">
                                <DataShape>
                                    <FieldDefinitions>
                                        <FieldDefinition
                                         baseType="STRING"
                                         description="code"
                                         name="code"
                                         ordinal="0"></FieldDefinition>
                                    </FieldDefinitions>
                                </DataShape>
                                <Rows>
                                    <Row>
                                        <code>
                                        <![CDATA[
                                        let result = Resources["InfoTableFunctions"].CreateInfoTable({
                                        	infoTableName: "DynamicInfoTable"
                                        });
                                        
                                        const THING_DELIMITER = ">";
                                        
                                        try {
                                        	let manager = Things["TWSC.ProficyHistorianAPI.EntryPoint"].GetConfiguredComponentManager();
                                        
                                        	// Add the timestamp
                                        	result.AddField({
                                        		name: "timestamp",
                                        		baseType: "DATETIME"
                                        	});
                                        
                                        	// Add the other fields
                                        	let tagList = propertyNames.rows.toArray().map(row => {
                                        		result.AddField({
                                        			name: row.name,
                                        			baseType: "NUMBER"
                                        		});
                                        		return thingName + THING_DELIMITER + row.name;
                                        	}).join(";");
                                        
                                        	let minimum = Math.min(5000, maxItems).toString();
                                        	let dataJSON = Things[manager].ExecuteRequest({
                                        		Parameter2: startDate.toISOString(),
                                        		Parameter1: tagList,
                                        		Parameter4: minimum,
                                        		Parameter3: endDate.toISOString(),
                                        		Parameter6: undefined,
                                        		RequestDisplayName: "Get raw data",
                                        		Parameter5: "1",
                                        		RequestBody: undefined
                                        	});
                                        
                                        	dataJSON.Data.forEach(data => {
                                        		let propertyName = data.TagName.split(THING_DELIMITER)[1].trim();
                                        		const dataItem = data;
                                        		dataItem.Samples.forEach(sample => {
                                        			let dt = parseDateISO(sample.TimeStamp);
                                        			if (dt >= startDate && dt <= endDate) {
                                        				var newRow = {};
                                        				newRow.timestamp = parseDateISO(sample.TimeStamp);
                                        				newRow[propertyName] = sample.Value;
                                        				result.AddRow(newRow);
                                        			}
                                        		});
                                        	});
                                        } catch (err) {
                                        	logger.error("{} - {}:{} - {}", me.name, err.fileName, err.lineNumber, err);
                                        	throw ("An error has occurred. Please check the script logs for more details.");
                                        }
                                        ]]>
                                        </code>
                                    </Row>
                                </Rows>
                            </ConfigurationTable>
                        </ConfigurationTables>
                    </ServiceImplementation>
