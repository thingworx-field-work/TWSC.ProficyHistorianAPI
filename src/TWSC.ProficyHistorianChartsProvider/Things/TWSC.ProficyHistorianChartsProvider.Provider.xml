                                <Rows>
                                    <Row>
                                        <code>
                                        <![CDATA[
                                        let result = 0;
                                        
                                        const THING_DELIMITER = ">";
                                        
                                        try {
                                        	// Use UCL property if it exists to get max property
                                        	if (hasProperty(thingName, propertyName + "_UCL")) {
                                        		result = Things[thingName][propertyName + "_UCL"];
                                        	} else {
                                        		let manager = Things["TWSC.ProficyHistorianAPI.EntryPoint"].GetConfiguredComponentManager();
                                        		let tagName = thingName + THING_DELIMITER + propertyName;
                                        		let tagsJSON = Things[manager].ExecuteRequest({
                                        			Parameter2: undefined,
                                        			Parameter1: tagName,
                                        			Parameter4: undefined,
                                        			Parameter3: undefined,
                                        			Parameter6: undefined,
                                        			RequestDisplayName: "Get tag properties",
                                        			Parameter5: undefined,
                                        			RequestBody: undefined
                                        		});
                                        		if (tagsJSON.HiEngineeringUnits) {
                                        			result = tagsJSON.HiEngineeringUnits;
                                        		}
                                        	}
                                        } catch (err) {
                                        	logger.error("{} - {}:{} - {}", me.name, err.fileName, err.lineNumber, err);
                                        	throw ("An error has occurred. Please check the script logs for more details.");
                                        }
                                        
                                        function hasProperty(thingName, propertyName) {
                                        	let hasProperty = false;
                                        	let properties = Things[thingName].GetPropertyDefinitions();
                                        	let data = properties.rows.toArray().filter(row => row.name === propertyName);
                                        	if (data && data.length) {
                                        		hasProperty = true;
                                        	}
                                        	return hasProperty;
                                        }
                                        ]]>
                                        </code>
                                    </Row>
                                </Rows>
                            </ConfigurationTable>
                        </ConfigurationTables>
