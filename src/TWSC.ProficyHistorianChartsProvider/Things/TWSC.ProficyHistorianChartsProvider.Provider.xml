                                        <code>
                                        <![CDATA[
                                        let result = DataShapes["NumberValueStream"].CreateValues();
                                        
                                        try {
                                            let mgr = Things["TWSC.ProficyHistorianChartsProvider.EntryPoint"].GetConfiguredComponentManager();
                                            let apiMgr = Things["TWSC.ProficyHistorianAPI.EntryPoint"].GetConfiguredComponentManager();
                                        
                                            let minimum = Math.min(5000, maxItems).toString();
                                            let tagName = Things[mgr].GetHistorianTagName({
                                                    thingName: thingName,
                                                    propertyName: propertyName
                                                });
                                        	let dataJSON = Things[apiMgr].ExecuteRequest({
                                        		Parameter2: startDate.toISOString(),
                                        		Parameter1: tagName,
                                                Parameter4: minimum,
                                        		Parameter3: endDate.toISOString(),
                                        		Parameter6: undefined,
                                        		RequestDisplayName: "Get raw data",
                                        		Parameter5: "1",
                                        		RequestBody: undefined
                                        	});
                                        
                                        	const dataItem = dataJSON.Data[0];
                                        	dataItem.Samples.forEach(sample => {
                                        		let dt = parseDateISO(sample.TimeStamp);
                                        		if (dt >= startDate && dt <= endDate) {
                                        			result.AddRow({
                                        				value: sample.Value, // NUMBER
                                        				timestamp: parseDateISO(sample.TimeStamp) //DATETIME
                                        			});
                                        		}
                                        	});
                                        } catch (err) {
                                        	logger.error("{} - {}:{} - {}", me.name, err.fileName, err.lineNumber, err);
                                        	throw ("An error has occurred. Please check the script logs for more details.");
                                        }
                                        ]]>
                                        </code>
                                    </Row>
                                </Rows>
