                    <ServiceImplementation
                     description=""
                     handlerName="Script"
                     name="QueryMultiPropertiesForCharts">
                        <ConfigurationTables>
                            <ConfigurationTable
                             dataShapeName=""
                             description=""
                             isMultiRow="false"
                             name="Script"
                             ordinal="0">
                                <DataShape>
                                    <FieldDefinitions>
                                        <FieldDefinition
                                         baseType="STRING"
                                         description="code"
                                         name="code"
                                         ordinal="0"></FieldDefinition>
                                    </FieldDefinitions>
                                </DataShape>
                                <Rows>
                                    <Row>
                                        <code>
                                        <![CDATA[
                                        let result = Resources["InfoTableFunctions"].CreateInfoTable({
                                        	infoTableName: "DynamicInfoTable"
                                        });
                                        
                                        try {
                                        	let mgr = Things["TWSC.ProficyHistorianChartsProvider.EntryPoint"].GetConfiguredComponentManager();
                                        	let apiMgr = Things["TWSC.ProficyHistorianAPI.EntryPoint"].GetConfiguredComponentManager();
                                        
                                        	// Add the timestamp
                                        	result.AddField({
                                        		name: "timestamp",
                                        		baseType: "DATETIME"
                                        	});
                                        
                                        	// Build Historian tag list and reverse lookup
                                        	let tagMap = {};
                                        
                                        	let tagList = propertyNames.rows.toArray().map(row => {
                                        		let propertyName = row.name;
                                        
                                        		result.AddField({
                                        			name: propertyName,
                                        			baseType: "NUMBER"
                                        		});
                                        
                                        		let historianTag = Things[mgr].GetHistorianTagName({
                                        			thingName: thingName,
                                        			propertyName: propertyName
                                        		});
                                        
                                        		tagMap[historianTag] = propertyName;
                                        
                                        		return historianTag;
                                        	}).join(";");
                                        
                                        	let minimum = Math.min(5000, maxItems).toString();
                                        
                                        	let dataJSON = Things[apiMgr].ExecuteRequest({
                                        		Parameter2: startDate.toISOString(),
                                        		Parameter1: tagList,
                                        		Parameter4: minimum,
                                        		Parameter3: endDate.toISOString(),
                                        		Parameter6: undefined,
                                        		RequestDisplayName: "Get raw data",
                                        		Parameter5: "1",
                                        		RequestBody: undefined
                                        	});
                                        
                                        	dataJSON.Data.forEach(data => {
                                        		let propertyName = tagMap[data.TagName];
                                        
                                        		data.Samples.forEach(sample => {
                                        			let dt = parseDateISO(sample.TimeStamp);
                                        
                                        			if (dt >= startDate && dt <= endDate) {
                                        				let newRow = {};
                                        				newRow.timestamp = dt;
                                        				newRow[propertyName] = sample.Value;
                                        				result.AddRow(newRow);
                                        			}
                                        		});
                                        	});
                                        
                                        } catch (err) {
                                        	logger.error("{} - {}:{} - {}", me.name, err.fileName, err.lineNumber, err);
                                        	throw ("An error has occurred. Please check the script logs for more details.");
                                        }
                                        ]]>
                                        </code>
                                    </Row>
                                </Rows>
                            </ConfigurationTable>
                        </ConfigurationTables>
                    </ServiceImplementation>
