                    <ServiceImplementation
                     description=""
                     handlerName="Script"
                     name="GetChartTrendProperties">
                        <ConfigurationTables>
                            <ConfigurationTable
                             dataShapeName=""
                             description=""
                             isMultiRow="false"
                             name="Script"
                             ordinal="0">
                                <DataShape>
                                    <FieldDefinitions>
                                        <FieldDefinition
                                         baseType="STRING"
                                         description="code"
                                         name="code"
                                         ordinal="0"></FieldDefinition>
                                    </FieldDefinitions>
                                </DataShape>
                                <Rows>
                                    <Row>
                                        <code>
                                        <![CDATA[
                                        // GetChartTrendProperties returns the properties that can be charted.  See PTC.Charts.DefaultProvider->GetChartTrendProperties
                                        // for an example of how this service works with ThingWorx
                                        let result = DataShapes["GenericStringList"].CreateValues();
                                        
                                        try {
                                            // see if there are any mapped properties in the Thing config before using the default behavior for querying tags
                                            let mgr = Things["TWSC.ProficyHistorianChartsProvider.EntryPoint"].GetConfiguredComponentManager();
                                            
                                            let mappedTags = Things[mgr].GetMappedProperties({thingName: entityName});
                                            if (mappedTags && mappedTags.rows && mappedTags.rows.length > 0) {
                                            	const propertyDefinitions = Things[entityName].GetPropertyDefinitions();
                                            	const existingPropertyNames = propertyDefinitions.rows.toArray()
                                                	.map(property => property.name);
                                        
                                            	mappedTags.rows.toArray().forEach(mapRow => {
                                                	if (mapRow.PropertyName && existingPropertyNames.indexOf(mapRow.PropertyName) !== -1) {
                                                    	result.AddRow({
                                                        	item: mapRow.PropertyName
                                                    	});
                                                	}
                                            	});
                                            } else {
                                                const THING_DELIMITER = ">";
                                                
                                                let apiMgr = Things["TWSC.ProficyHistorianAPI.EntryPoint"].GetConfiguredComponentManager();
                                                let tagsJSON = Things[apiMgr].ExecuteRequest({
                                                    Parameter2: 10000 /* STRING */ ,
                                                    Parameter1: entityName + THING_DELIMITER + "*",
                                                    Parameter4: undefined /* STRING */ ,
                                                    Parameter3: undefined /* STRING */ ,
                                                    Parameter6: undefined /* STRING */ ,
                                                    RequestDisplayName: "Get tags with name mask",
                                                    Parameter5: undefined /* STRING */ ,
                                                    RequestBody: undefined
                                                });
                                                let obj = Object();
                                                tagsJSON.Tags.forEach(item => {
                                                    const [thingName, property] = item.split(THING_DELIMITER);
                                                    if (entityName == thingName && property.length > 0) {
                                                        obj.item = property;
                                                        result.AddRow(obj);
                                                    }
                                                });
                                                
                                            }
                                        } catch (err) {
                                        	logger.error("{} - {}:{} - {}", me.name, err.fileName, err.lineNumber, err);
                                        	throw ("An error has occurred. Please check the script logs for more details.");
                                        }
                                        ]]>
                                        </code>
                                    </Row>
                                </Rows>
                            </ConfigurationTable>
                        </ConfigurationTables>
                    </ServiceImplementation>
                    <ServiceImplementation
                     description=""
                     handlerName="Script"
                     name="GetLoggedPropertiesForThing">
                        <ConfigurationTables>
                            <ConfigurationTable
                             dataShapeName=""
                             description=""
                             isMultiRow="false"
                             name="Script"
                             ordinal="0">
                                <DataShape>
                                    <FieldDefinitions>
                                        <FieldDefinition
                                         baseType="STRING"
                                         description="code"
                                         name="code"
                                         ordinal="0"></FieldDefinition>
                                    </FieldDefinitions>
                                </DataShape>
                                <Rows>
                                    <Row>
                                        <code>
                                        <![CDATA[
                                        // GetLoggedPropertiesForThing returns the properties that can be charted.  See PTC.Charts.DefaultProvider->GetLoggedPropertiesForThing
                                        // for an example of how this service works with ThingWorx
                                        let result = DataShapes["PropertyDefinition"].CreateValues();
                                        
                                        const THING_DELIMITER = ">";
                                        
                                        try {
                                        	let apiMgr = Things["TWSC.ProficyHistorianAPI.EntryPoint"].GetConfiguredComponentManager();
                                        
                                        	// see if there are any mapped properties in the Thing config before using the default behavior for querying tags
                                        	let mgr = Things["TWSC.ProficyHistorianChartsProvider.EntryPoint"].GetConfiguredComponentManager();
                                        
                                        	let mappedTags = Things[mgr].GetMappedProperties({
                                        		thingName: thingName
                                        	});
                                        	if (mappedTags && mappedTags.rows && mappedTags.rows.length > 0) {
                                        		const propertyDefinitions = Things[thingName].GetPropertyDefinitions();
                                        		const existingPropertyNames = propertyDefinitions.rows.toArray()
                                        			.map(property => property.name);
                                        
                                        		mappedTags.rows.toArray().forEach(mapRow => {
                                        			if (mapRow.PropertyName && existingPropertyNames.indexOf(mapRow.PropertyName) !== -1) {
                                        				let tagProps = Things[apiMgr].ExecuteRequest({
                                        					Parameter2: undefined,
                                        					Parameter1: mapRow.HistorianTag,
                                        					Parameter4: undefined,
                                        					Parameter3: undefined,
                                        					Parameter6: undefined,
                                        					RequestDisplayName: "Get tag properties",
                                        					Parameter5: undefined,
                                        					RequestBody: undefined
                                        				});
                                        				let bType = "NUMBER"; // Number is base type 2
                                        				if (tagProps.DataType) {
                                        					if (tagProps.DataType == 7) {
                                        						bType = "STRING";
                                        					} else if (tagProps.DataType == 2) { // Use NUMBER set as default
                                        					}
                                        				}
                                        				result.AddRow({
                                        					name: mapRow.PropertyName,
                                        					baseType: bType
                                        				});
                                        			}
                                        		});
                                                
                                        	} else {
                                        
                                        		let tagsJSON = Things[apiMgr].ExecuteRequest({
                                        			Parameter2: 10000 /* STRING */ ,
                                        			Parameter1: thingName + THING_DELIMITER + "*",
                                        			Parameter4: undefined /* STRING */ ,
                                        			Parameter3: undefined /* STRING */ ,
                                        			Parameter6: undefined /* STRING */ ,
                                        			RequestDisplayName: "Get tags with name mask",
                                        			Parameter5: undefined /* STRING */ ,
                                        			RequestBody: undefined
                                        		});
                                        
                                        		tagsJSON.Tags.forEach(item => {
                                        			const [myThingName, property] = item.split(THING_DELIMITER);
                                        			if (thingName == myThingName && property.length > 0) {
                                        				let tagName = thingName + THING_DELIMITER + property;
                                        				let tagProps = Things[apiMgr].ExecuteRequest({
                                        					Parameter2: undefined,
                                        					Parameter1: tagName,
                                        					Parameter4: undefined,
                                        					Parameter3: undefined,
                                        					Parameter6: undefined,
                                        					RequestDisplayName: "Get tag properties",
                                        					Parameter5: undefined,
                                        					RequestBody: undefined
                                        				});
                                        				let bType = "NUMBER"; // Number is base type 2
                                        				if (tagProps.DataType) {
                                        					if (tagProps.DataType == 7) {
                                        						bType = "STRING";
                                        					} else if (tagProps.DataType == 2) { // Use NUMBER set as default
                                        					}
                                        				}
                                        				result.AddRow({
                                        					name: property,
                                        					baseType: bType
                                        				});
                                        			}
                                        		});
                                        	}
                                        } catch (err) {
                                        	logger.error("{} - {}:{} - {}", me.name, err.fileName, err.lineNumber, err);
                                        	throw ("An error has occurred. Please check the script logs for more details.");
                                        }
                                        ]]>
                                        </code>
                                    </Row>
                                </Rows>
                            </ConfigurationTable>
                        </ConfigurationTables>
