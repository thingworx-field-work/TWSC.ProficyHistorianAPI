                <ServiceImplementations>
                    <ServiceImplementation
                     description=""
                     handlerName="Script"
                     name="DeployComponent">
                        <ConfigurationTables>
                            <ConfigurationTable
                             dataShapeName=""
                             description=""
                             isMultiRow="false"
                             name="Script"
                             ordinal="0">
                                <DataShape>
                                    <FieldDefinitions>
                                        <FieldDefinition
                                         baseType="STRING"
                                         description="code"
                                         name="code"
                                         ordinal="0"></FieldDefinition>
                                    </FieldDefinitions>
                                </DataShape>
                                <Rows>
                                    <Row>
                                        <code>
                                        <![CDATA[
                                        var result = false;
                                        try {
                                        
                                        	let modelManagementEntryPoint = "PTC.ModelManagement.EntryPoint";
                                        	if (Things[modelManagementEntryPoint]) {
                                        		let modelManagementManager = Things[modelManagementEntryPoint].GetConfiguredComponentManager();
                                        		Things[modelManagementManager].AddLocalizationToken({
                                        			tableName: 'Default' /* STRING */ ,
                                        			tokenName: 'TWSC.ProficyHistorianChartsProvider.AdminConfiguration' /* STRING */ ,
                                        			tokenValue: 'Configuration' /* STRING */ ,
                                        			tokenContext: 'Admin Menu' /* STRING */ ,
                                        			tokenUsage: 'label' /* STRING */
                                        		});
                                        		Things[modelManagementManager].AddLocalizationToken({
                                        			tableName: 'Default' /* STRING */ ,
                                        			tokenName: 'TWSC.ProficyHistorianAPI.ExecuteRequest' /* STRING */ ,
                                        			tokenValue: 'Execute Request' /* STRING */ ,
                                        			tokenContext: 'Admin Menu' /* STRING */ ,
                                        			tokenUsage: 'label' /* STRING */
                                        		});
                                        	}
                                        
                                            // Add the Editable Configuration Table to the TWSC.ProficyHistorianAPI BB for the AdminConfiguration MU to use
                                        	const configurationManagementEntryPoint = "PTCTS.ConfigurationManagement.EntryPoint";
                                        	if (Things[configurationManagementEntryPoint]) {
                                        		const configurationManager = Things[configurationManagementEntryPoint].GetConfiguredComponentManager();
                                        		const componentManager = Things['TWSC.ProficyHistorianAPI.EntryPoint'].GetConfiguredComponentManager();
                                        
                                        		const tableName = "EditableConfigurationTables";
                                        
                                        		// GetConfigurationTable throws when the table is not defined on this manager.
                                        		try {
                                        			Things[componentManager].GetConfigurationTable({
                                        				tableName: tableName
                                        			});
                                        		} catch (tableLookupError) {
                                        			Things[componentManager].AddConfigurationTableDefinition({
                                        				isMultiRow: true,
                                        				name: tableName,
                                        				dataShapeName: "PTCTS.ConfigurationManagement.EditableConfigurationTables_DS"
                                        			});
                                        		}
                                        
                                        		const jsonRows = {
                                        			rows: [{
                                        				ConfigurationTableName: "RequestConfiguration",
                                        				Description: "APIs available to call from Proficy Historian",
                                        				DisplayName: "API Request Specifications",
                                        				AllowAdd: false,
                                        				AllowEdit: false,
                                        				AllowDelete: false,
                                        				DefaultConfigurableJSON: {}
                                        			}]
                                        		};
                                        
                                        		Things[configurationManager].AddRowsToManagerConfigurationTable({
                                        			jsonRows: jsonRows,
                                        			managerName: componentManager,
                                        			configurationTableName: tableName,
                                        			primaryKey: "ConfigurationTableName"
                                        		});
                                        	}
                                        
                                        	result = true;
                                        
                                        } catch (err) {
                                        	logger.error("{} - {}:{} - {}", me.name, err.fileName, err.lineNumber, err);
                                        	throw ("An error has occurred. Please check the script logs for more details.");
                                        }
                                        ]]>
                                        </code>
                                    </Row>
