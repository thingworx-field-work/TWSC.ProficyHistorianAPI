                                    <code>
                                    <![CDATA[
                                    try {
                                        const mmEntry = "PTC.ModelManagement.EntryPoint";
                                    	const modelManager = Things[mmEntry].GetConfiguredComponentManager();
                                    	let configurationTableName = "ProficyHistorianTagConfiguration";
                                    
                                    	var configuration = Things[modelManager].GetConfigurationTableForEntity({
                                    		isMultiRow: true /* BOOLEAN */ ,
                                    		entityName: thingName /* STRING */ ,
                                    		entityType: "Thing" /* STRING */ ,
                                    		configurationTableName: configurationTableName /* STRING */ ,
                                    		dataShapeName: "TWSC.ProficyHistorianChartsProvider.ProficyHistorianTagConfiguration_DS" /* STRING */ ,
                                    		autoCreate: true
                                    	});
                                    
                                    	var propertyFound = false;
                                    	if (propertyName) {
                                    		for (var i = 0; i < configuration.length; i++) {
                                    			if (configuration[i].PropertyName === propertyName) {
                                    				configuration[i].HistorianTag = historianTag;
                                    				propertyFound = true;
                                    			}
                                    		}
                                    	}
                                    
                                    	configurationTableName = Things[modelManager].GetConfigurationTableName({
                                    		entityName: thingName,
                                    		configurationTableName: configurationTableName
                                    	});
                                    	if (!propertyFound) {
                                    		configuration.AddRow({
                                    			"PropertyName": propertyName,
                                    			"HistorianTag": historianTag
                                    		});
                                    	}
                                    
                                    	Things[thingName].SetMultiRowConfigurationTable({
                                    		configurationTable: configuration /* INFOTABLE */ ,
                                    		persistent: true /* BOOLEAN */ ,
                                    		tableName: configurationTableName /* STRING */
                                    	});
                                    } catch (err) {
                                    	logger.error("{} - {}:{} - {}", me.name, err.fileName, err.lineNumber, err);
